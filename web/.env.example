# URL of the SyncTune backend (FastAPI + yt-dlp). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Supabase. If both are empty the app runs in LOCAL mode
# (data stored in the browser, realtime across tabs via BroadcastChannel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: WebRTC TURN server (helps voice chat behind strict NAT).
# Leave empty to use public STUN servers only.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
