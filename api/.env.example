HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*            # comma separated list, e.g. http://localhost:3000
CACHE_TTL=1800            # seconds to cache yt-dlp extraction results
YTDLP_COOKIES_FROM_BROWSER=   # optional (local dev), e.g. "chrome" or "firefox" to bypass bot checks
YTDLP_COOKIEFILE=             # optional (deploy), path to cookies.txt (e.g. /etc/secrets/cookies.txt on Render)
YTDLP_COOKIES=               # optional (deploy), raw Netscape cookies.txt content (written to a temp file)
PROXY_ALLOWED_HOSTS=googlevideo.com,ytimg.com,tiktokcdn.com,tiktokcdn-us.com,ttwstatic.com,ibytedtos.com,akamaized.net,bc.googleusercontent.com
